{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(make test:*)",
      "Bash(make test-backend)",
      "Bash(make test-frontend)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(clinic-app/backend/clinic.db)",
      "Read(clinic-app/backups/**)",
      "Read(**/.env)"
    ]
  },
  "model": "claude-sonnet-5-5",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify-on-finish.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true,
    "cl-core@cl": true,
    "cl-dev@cl": true,
    "cl-ba-qa@cl": true,
    "cl-lead@cl": true
  },
  "extraKnownMarketplaces": {
    "cl": {
      "source": {
        "source": "github",
        "repo": "thanhtruong-agilityio/claude-config"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "advisorModel": "opus"
}
